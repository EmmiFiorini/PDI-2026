% guia 1 punto 2

clear
clc
%abrir imagen
im = imread('Lena.png');

%imagen en gris
im_gris = rgb2gray(im);

%imprimo en gris
figure(1)
imshow(im_gris);

%imprimo los colores
figure(2)
red_channel = im;
gre
im = imread('Lena.png');
subplot(3,1,1)
red_channel = im(:,:,1);
imshow(red_channel);

subplot(3,1,3)
green_channel = im(:,:,2);
imshow(green_channel);

subplot(3,1,2)
blue_channel = im(:,:,3);
imshow(blue_channel);