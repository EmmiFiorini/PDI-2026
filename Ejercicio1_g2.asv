%Guia 2 punto 1 PDI

clear
clc

%abrir imagen 
im = imread('Lena.png');

%% a
%pongo en blanco y negro
im_gris = rgb2gray(im);

%muestro el histograma junto con la imagen og:
figure(1)
subplot(2,1,1);
    imshow(im_gris);
    title('Lena blanco y negro');
subplot(2,1,2);
    imhist(im_gris);
    title('Histograma');

%% b: muestro el histograma junto con la imagen de cada color

%Rojo (imagen)
red_channel = im; %hago q sea 3D
red_channel(:,:,2) = 0; %apago el verde
red_channel(:,:,3) = 0; %apago el azul

%Verde (imagen)
green_channel = im; %hago q sea 3D
green_channel(:,:,1) = 0; %apago el rojo
green_channel(:,:,3) = 0; %apago el azul

%Azul (imagen)
blue_channel = im; %hago q sea 3D
blue_channel(:,:,2) = 0; %apago el verde
blue_channel(:,:,1) = 0; %apago el rojo

%extraigo cada canal para el histograma
R = im(:,:,1);
G = im(:,:,2);
B = im(:,:,3);

%grafico:
figure(2)
subplot(3,2,1);
    imshow(red_channel);
    title('Lena Rojo');

subplot(3,2,2);
    imhist(R);
    title('Histograma Rojo');

subplot(3,2,3);
    imshow(green_channel);
    title('Lena Verde');

subplot(3,2,4);
    imhist(G);
    title('Histograma Verde');
    
subplot(3,2,5);
    imshow(blue_channel);
    title('Lena Azul');

subplot(3,2,6);
    imhist(B);
    title('Histograma Azul');
    
%% c:
% La altura de cada bin representa la cantidad de pixeles de la imagen que
% tienen ese nivel de intensidad

%% d

% i:
hG = histogram(G(:), 0:256, 'Normalization', 'probability');
    % se pone G(:) xq hay q pasarle un vector columna
    %'Normalization','probability': te da la probabilidad de q un pixel
    %elegido al azar tenga ese valor

P_verde_137 = hG.Values(138); %pongo 138 xq matlab cuenta desde el 1 y no desde el 0
P_verde_137 = sum(G(:) == 137) / numel(G); %Prob= (casos favorables) / (casos totales)

disp('d)i) La prob de elegir un pixel al azar y su intensidad en el canal verde sea de 137 es de: ' );
P_verde_137

% ii:
hR = histogram(R(:), 0:256, 'Normalization', 'probability');
P_rojo_20_180 = sum(hR.Values(21:181));

disp('d)ii) La prob de elegir un pixel al azar y su intensidad en el canal rojo sea de 20-180 es de: ' );
P_rojo_20_180

% iii
%Me pide la prob de que tenga rojo entre 100-120 y azul entre 80-100 si
%agarro un pixel
%Utilizando solo los histogramas tengo que suponer que las probs del rojo y
%el azul son INDEPENDIENTES --> P(rojo 100-120 Y azul 80-100)?P(rojo 100-120)×P(azul 80-100)


